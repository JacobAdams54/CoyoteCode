{
  "name": "coyotecode",
  "version": "1.0.0",
  "private": true,
  "description": "CoyoteCode frontend, backend, and agent harness monorepo.",
  "workspaces": [
    "agent",
    "server",
    "client"
  ],
  "scripts": {
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspace agent",
    "dev:agent": "npm run dev --workspace agent",
    "dev:backend": "npm run dev --workspace backend",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
